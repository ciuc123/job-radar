DATABASE_URL=postgresql://user:password@host.neon.tech/jobradar?sslmode=require
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me
APP_ADMIN_EMAILS=andrei@ciuculescu.com
APP_OWNER_EMAIL=andrei@ciuculescu.com
CRON_SECRET=replace-with-a-long-random-secret
# AI (Anthropic API). Everything is off by default; rules-based scoring needs none of this.
ANTHROPIC_API_KEY=
AI_COPILOT_ENABLED=false
AI_ANALYSIS_ENABLED=false
AI_JOB_FACTS_ENABLED=false
# One-off per-user work (profile drafts, score explanations).
AI_MODEL_PROFILE=claude-sonnet-5-5
# On-demand "Analyze fit" on a job page. Run `npm run ai:eval` before switching (e.g. claude-haiku-5-5).
AI_MODEL=claude-opus-5-5
# Max on-demand AI analyses per user per UTC day.
AI_DAILY_LIMIT=20
# Bulk per-job work (scheduled second opinion, job facts).
AI_MODEL_BULK=claude-haiku-5-5
AI_MONTHLY_CALL_CAP=40
AI_MONTHLY_BUDGET_USD=60
AI_MAX_JOBS_PER_USER_RUN=30
AI_CONCURRENCY=4
AI_BLEND_WEIGHT=0
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TO=
EMAIL_NOTIFICATIONS_ENABLED=false
IMMEDIATE_ALERT_SCORE=92
# Minimum minutes between manual "Fetch all sources" runs (Pro); the scheduled run counts too.
MANUAL_FETCH_COOLDOWN_MINUTES=15
# Himalayas: recent-first search pages per profile keyword per run (first run backfills this many pages).
HIMALAYAS_MAX_PAGES_PER_TERM=5
